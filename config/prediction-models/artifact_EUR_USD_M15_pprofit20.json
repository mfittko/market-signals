 "trade": "entry at the next M15 bar open (long ask / short bid); stop 1.5 x Wilder ATR14 of mid M15 = 1R; breakeven after +1R (one-bar latency), 3R target, exit at the next open after an opposite M15 supertrend flip (ATR10, mult 3, mid), time exit after 72 bars; label = net R > 0 after bid/ask",
 "decision": "score at the close of a completed M15 bar i (bars <= i only); mid = (bid + ask) / 2 per OHLC field",
 "features": {
  "order": [
   "spr",
   "h_s1",
   "h_c1",
   "h_s2",
   "h_c2",
   "h_s3",
   "h_c3",
   "mon",
   "fri",
   "lrv12",
   "lrv72",
   "latr",
   "lrng",
   "mv",
   "st_al",
   "h1_al",
   "dst",
   "burst"
  ],
  "definitions": {
   "spr": "(ask_c - bid_c) / (1.5 * atr14), clip [0, 2]",
   "h_sK/h_cK": "sin/cos(K * 2 pi * ((t + 15) mod 1440) / 1440), t = bar start in UTC minutes, K = 1..3",
   "mon/fri": "trading day (22:00 UTC roll: day = floor((t + 120) / 1440)) is Monday / Friday: (day + 3) mod 7 == 0 / 4",
   "lrv12/lrv72": "log(max(sqrt(mean of (c_j - c_{j-1})^2 over the last N bars j <= i), 1e-12 * atr14) / atr14), clip [-3, 3]",
   "latr": "log(atr14 / mean(atr14 over the last 1440 bars incl. i)), clip [-3, 3]",
   "lrng": "clip(log(max(day high - day low of mid bars so far incl. i, 1e-12 * atr14) / atr14), -5, 5) - tod_norm[slot], slot = ((t + 120) mod 1440) / 15",
   "mv": "side * (c_i - open of the first bar of the trading day) / atr14, clip [-20, 20]",
   "st_al": "side * M15 supertrend trend (+1/-1, production ATR10 mult 3 on mid)",
   "h1_al": "side * trend of the last COMPLETED H1 supertrend bar (H1 = M15 resampled on the hour; usable when H1 start + 60 <= t + 15)",
   "dst": "side * (c_i - M15 supertrend line) / atr14, clip [-10, 10]",
   "burst": "side * sign(c_i - c_{i-3}) if |c_i - c_{i-3}| / atr14 > 2.5 else 0",
   "atr14": "Wilder ATR14 on mid: TR_0 = h-l, TR_j = max(h-l, |h-c_{j-1}|, |l-c_{j-1}|); seed = mean(TR_0..TR_13) at index 13; atr_j = (13 atr_{j-1} + TR_j) / 14"
  },
  "valid": "atr14 finite > 0, M15 and H1 trend nonzero, all features finite (1440-bar ATR mean warm-up)"
 },
