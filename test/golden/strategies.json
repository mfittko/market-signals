  {
   "name": "per-combo-name-follows-active-version",
   "input": {
    "kind": "resolve",
    "instrument": "SYNTH/USD",
    "granularity": "M5",
    "settings": {
     "bot": {
      "bots": {
       "SYNTH/USD|M5": {
        "enabled": true,
        "strategyName": "alpha",
        "riskPct": 1,
        "allocationPct": 0,
        "killSwitchDrawdownPct": "5"
       }
      }
     }
    },
    "rows": [
     ["alpha", 1, 0, 1],
     ["alpha", 2, 1, 0],
     ["beta", 1, 1, 0],
     ["gamma", 1, 0, 0]
    ]
   },
   "expected": {
    "botFor": {
     "configured": true,
     "enabled": true,
     "strategyId": null,
     "strategyName": "alpha",
     "riskPct": 1,
     "allocationPct": null,
     "killSwitchDrawdownPct": null
    },
    "resolved": {
     "name": "alpha",
     "version": 2
    }
   }
  },
