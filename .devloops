version: 1

# CI is set up (.github/workflows/ci.yml), so the dev-loop CI gate is back in
# force with shipped defaults (both gates require green CI). No overrides needed.

# UI-review recipe (signal-server web app). The signal-server has no auth, so no
# login recipe; flows are the explicit allowlist for /loop-review-ui.
# Worktrees get tracked files only: no worktree.entries copy or link of data/
# (about 42 GB of live market data). The server below creates an empty
# data/candles.db in the worktree on first db access; a missing
# data/settings.json reads as {} and is written on the first settings save.
uiReview:
  run:
    command: "MS_NO_NOTIFY=1 node scripts/signal-server.mjs --port 4123"
    readyUrl: "http://127.0.0.1:4123/"
    readyTimeoutMs: 60000
  flows:
    - name: chart-latest
      pathPatterns: ["scripts/signal-server.mjs"]
      steps:
        - { action: goto, path: "/", name: latest-signal-chart }
    - name: chart-deep-link
      pathPatterns: ["scripts/signal-server.mjs", "scripts/supertrend.mjs"]
      steps:
        - { action: goto, path: "/?instrument=WTICO%2FUSD&granularity=M5&t=2026-07-22T10%3A15%3A00.000000000Z", name: deep-linked-signal }
    - name: chat-threads-view-scope
      pathPatterns: ["scripts/signal-server.mjs"]
      steps:
        - { action: goto, path: "/?instrument=WTICO%2FUSD&granularity=M5", name: threads-wti-m5 }
        - { action: goto, path: "/?instrument=WTICO%2FUSD&granularity=M1", name: threads-wti-m1 }
    # portfolio modal needs a seeded portfolio; the declarative flow only loads
    # the page (section hidden on a fresh db is valid) — the modal drive runs in
    # the manual seeded UI-review pass documented on the PR.
    - name: portfolio-view
      pathPatterns: ["scripts/signal-server.mjs", "scripts/portfolio.mjs"]
      steps:
        - { action: goto, path: "/", name: portfolio-section }
    - name: chart-indicators
      pathPatterns: ["scripts/signal-server.mjs", "scripts/indicators.mjs", "scripts/axis-snapshot.mjs"]
      steps:
        - { action: goto, path: "/?ind=ema%2Cbb%2Cvwap%2Crsi", name: indicators-on }
        - { action: goto, path: "/", name: indicators-off }
    - name: settings-roundtrip
      pathPatterns: ["scripts/signal-server.mjs", "vendor/app.html"]
      steps:
        - { action: goto, path: "/", name: open-config }
        - { action: click, selector: "#cfgbtn", name: open-settings-modal }
        # the modal reopens on the LAST-USED tab (persisted in localStorage), so a
        # sibling flow that visited another tab would leave the model field absent.
        # Every settings flow names its own tab. The model input renders only for
        # a provider that takes a model, and empty settings select provider none,
        # so the flow selects openai first.
        - { action: click, selector: "#cfgTabs button[data-tab=llm]", name: llm-provider-tab }
        - { action: select, selector: "#f-provider", value: "openai", name: select-openai-provider }
        - { action: fill, selector: "#f-__model", value: "ui-review-model", name: fill-model }
        - { action: click, selector: "#cfg button", name: save-settings }
        - { action: goto, path: "/", name: reload-after-save }
    # the GNews fields (second opt-in news provider, alongside NEWSAPI_AI_*) live
    # on the News provider tab — drive them so the review loop actually renders
    # the masked key input and the off/shadow/auto mode select, not just the
    # LLM-tab fields the settings-roundtrip flow above already covers.
    - name: settings-news-gnews
      pathPatterns: ["scripts/signal-server.mjs", "vendor/app.html"]
      steps:
        - { action: goto, path: "/", name: open-config }
        - { action: click, selector: "#cfgbtn", name: open-settings-modal }
        - { action: click, selector: "#cfgTabs button[data-tab=news]", name: news-provider-tab }
        - { action: fill, selector: "#f-GNEWS_KEY", value: "ui-review-gnews-key", name: fill-gnews-key }
        - { action: select, selector: "#f-GNEWS_MODE", value: "shadow", name: select-gnews-mode }
        - { action: click, selector: "#cfg button", name: save-settings }
        - { action: goto, path: "/", name: reload-after-save }
    # the gates/standing-notes panel is global config: it lives in the ⚙ modal,
    # lazy-mounted on first open of its tab.
    - name: settings-gates-notes
      pathPatterns: ["scripts/signal-server.mjs", "vendor/app.html", "scripts/gate-prompts.mjs", "scripts/memories.mjs"]
      steps:
        - { action: goto, path: "/", name: open-config }
        - { action: click, selector: "#cfgbtn", name: open-settings-modal }
        - { action: click, selector: "#cfgTabs button[data-tab=global]", name: gates-notes-tab }
        - { action: click, selector: "#gatesTabs button[data-tab=recheck]", name: recheck-gate-panel }
    # Pushover fields (opt-in push target) live in the Advanced tab,
    # next to notifierBin — never a real Pushover request, just the fields render.
    - name: settings-advanced-pushover
      pathPatterns: ["scripts/signal-server.mjs", "vendor/app.html", "scripts/lib/pushover.mjs"]
      steps:
        - { action: goto, path: "/", name: open-config }
        - { action: click, selector: "#cfgbtn", name: open-settings-modal }
        - { action: click, selector: "#cfgTabs button[data-tab=adv]", name: advanced-tab }
        - { action: fill, selector: "input[name=PUSHOVER_TOKEN]", value: "ui-review-token", name: fill-pushover-token }
        - { action: fill, selector: "input[name=PUSHOVER_USER]", value: "ui-review-user", name: fill-pushover-user }
    # verdict-budget + fallback-provider fields: NOT contextual on the
    # provider select, so they render regardless of which provider is active.
    - name: settings-llm-fallback
      pathPatterns: ["scripts/signal-server.mjs", "vendor/app.html", "scripts/supertrend.mjs"]
      steps:
        - { action: goto, path: "/", name: open-config }
        - { action: click, selector: "#cfgbtn", name: open-settings-modal }
        - { action: fill, selector: "#f-filterMaxCompletionTokens", value: "20000", name: fill-verdict-budget }
        - { action: select, selector: "#f-llmFallbackProvider", value: "anthropic", name: select-fallback-provider }
        - { action: click, selector: "#cfg button", name: save-llm-fallback }

# Dev-loop tracker board (operator, 2026-07-22): user project 5 is the queue.
# Lives under tracker.board; the installed CLI rejects the old queue.board key.
tracker:
  board:
    number: 5

# Gate evidence policy (operator, 2026-08-04): gates fan out to several
# reviewers, but the pre-merge check does not require fan-out evidence.
gates:
  requireFanoutEvidence: false
  size:
    tiers:
      default:
        # 800, not 400: clean feature PRs here run 400-800 code lines and escalation voids the standing merge approval.
        softLoc: 800

# Merge policy (operator, 2026-11-16): standing merge approval for this repo.
# The agent may merge a PR once every gate is clean on the current head: CI,
# draft_gate, pre_approval_gate, Copilot convergence, size budget, and, for UI
# changes, the running-app UX review. Merges go through the sanctioned wrapper
# scripts/github/merge-pr.mjs with --human-approved-by mfittko
# --standing-authorization; it still refuses on any failing precondition.
# This overrides the shipped local-first default humanMergeOnly: true.
autonomy:
  humanMergeOnly: false

# Copilot reviews (operator, 2026-11-16): disabled for this repo. A round cap
# of 0 stops every Copilot request and round; merge-pr.mjs then passes Copilot
# convergence as copilot_gate_disabled. The draft_gate, pre_approval_gate and
# running-app UX review stay required.
refinement:
  maxCopilotRounds: 0
